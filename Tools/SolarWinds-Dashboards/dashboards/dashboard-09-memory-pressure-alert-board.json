{
  "schemaVersion": "2024.1",
  "source": "ServerOpsToolkit - Thwack-inspired community patterns",
  "dashboard": {
    "name": "Memory Pressure Alert Board",
    "description": "Modern Orion dashboard for Mixed infrastructure monitoring.",
    "category": "Mixed",
    "tags": [
      "Mixed",
      "Infrastructure",
      "ServerOpsToolkit"
    ],
    "autoRefresh": 300,
    "widgets": [
      {
        "id": "w-09-0",
        "title": "Status Summary",
        "type": "Status",
        "layout": {
          "x": 0,
          "y": 0,
          "width": 6,
          "height": 4
        },
        "dataSettings": {
          "swql": "SELECT Status, COUNT(*) AS Count FROM Orion.Nodes GROUP BY Status",
          "refreshRate": 300,
          "chartType": "table"
        }
      },
      {
        "id": "w-09-1",
        "title": "Top Offenders",
        "type": "Table",
        "layout": {
          "x": 6,
          "y": 0,
          "width": 6,
          "height": 4
        },
        "dataSettings": {
          "swql": "SELECT N.Caption, N.IPAddress, CPULoad, PercentMemoryUsed FROM Orion.Nodes N INNER JOIN Orion.CPULoad CL ON N.NodeID = CL.NodeID WHERE N.OSVersion LIKE '%Windows%' AND N.Status <> 9 ORDER BY CPULoad DESC",
          "refreshRate": 300,
          "chartType": "table"
        }
      },
      {
        "id": "w-09-2",
        "title": "24 Hour Trend",
        "type": "Timeseries",
        "layout": {
          "x": 0,
          "y": 4,
          "width": 6,
          "height": 4
        },
        "dataSettings": {
          "swql": "SELECT DateTime, AVG(StatValue) AS Value FROM Orion.ResponseTime WHERE DateTime > GETDATE()-1 GROUP BY DateTime",
          "refreshRate": 300,
          "chartType": "line"
        }
      },
      {
        "id": "w-09-3",
        "title": "Alert Count",
        "type": "Counter",
        "layout": {
          "x": 6,
          "y": 4,
          "width": 6,
          "height": 4
        },
        "dataSettings": {
          "swql": "SELECT COUNT(*) AS ActiveAlerts FROM Orion.AlertActive",
          "refreshRate": 300,
          "chartType": "table"
        }
      }
    ]
  }
}