{
  "version": 1,
  "commands": [
    {
      "id": "sb-001",
      "title": "Check pending reboot",
      "category": "Server Build",
      "tags": ["reboot", "health"],
      "favorite": true,
      "command": "Get-CimInstance -ClassName Win32_OperatingSystem | Select-Object CSName, LastBootUpTime; Test-Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired'"
    },
    {
      "id": "sb-002",
      "title": "Install Windows features batch",
      "category": "Server Build",
      "tags": ["features", "build"],
      "favorite": false,
      "command": "Install-WindowsFeature -Name Web-Server, NET-Framework-45-Core, RSAT-AD-PowerShell -IncludeManagementTools"
    },
    {
      "id": "f5-001",
      "title": "F5 pool member status (iControl REST)",
      "category": "F5",
      "tags": ["f5", "lb", "rest"],
      "favorite": false,
      "command": "$cred = Get-Credential; Invoke-RestMethod -Uri 'https://f5-mgmt.example.local/mgmt/tm/ltm/pool/~Common~app_pool/members' -Credential $cred -SkipCertificateCheck"
    },
    {
      "id": "st-001",
      "title": "Disk space report",
      "category": "Storage",
      "tags": ["disk", "monitoring"],
      "favorite": true,
      "command": "Get-CimInstance Win32_LogicalDisk -Filter \"DriveType=3\" | Select-Object DeviceID, @{N='FreeGB';E={[math]::Round($_.FreeSpace/1GB,2)}}, @{N='SizeGB';E={[math]::Round($_.Size/1GB,2)}}, @{N='FreePct';E={[math]::Round(100*$_.FreeSpace/$_.Size,1)}}"
    },
    {
      "id": "net-001",
      "title": "Test common ports",
      "category": "Networking",
      "tags": ["ports", "connectivity"],
      "favorite": false,
      "command": "443,445,3389,5985 | ForEach-Object { $r = Test-NetConnection -ComputerName $env:COMPUTERNAME -Port $_ -WarningAction SilentlyContinue; [pscustomobject]@{Port=$_; TcpTestSucceeded=$r.TcpTestSucceeded} }"
    },
    {
      "id": "hd-001",
      "title": "Audit local admins",
      "category": "Hardening",
      "tags": ["security", "audit"],
      "favorite": true,
      "command": "Get-LocalGroupMember -Group Administrators | Select-Object Name, ObjectClass, PrincipalSource"
    },
    {
      "id": "ad-001",
      "title": "Find stale computer accounts",
      "category": "Active Directory",
      "tags": ["ad", "cleanup"],
      "favorite": false,
      "command": "$days = 90; $cutoff = (Get-Date).AddDays(-$days); Get-ADComputer -Filter * -Properties LastLogonDate | Where-Object { $_.LastLogonDate -lt $cutoff } | Select-Object Name, LastLogonDate, Enabled"
    },
    {
      "id": "br-001",
      "title": "Windows Backup status",
      "category": "Backup/Restore",
      "tags": ["backup", "wbadmin"],
      "favorite": false,
      "command": "Get-WBBackupSet | Select-Object -First 5 BackupTime, VersionId, IsIncomplete"
    }
  ]
}
